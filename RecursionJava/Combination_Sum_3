class Solution {
    void fun(int k,int sum, int start,int n,ArrayList<Integer>diary,List<List<Integer>>ans){
         if(diary .size()==k && sum==n){
            ans.add(new ArrayList<>(diary));
            return ;
         }
         for(int i=start;i<=9;i++){
            if(sum+i>n){
                break;
            }
            diary.add(i);
            fun(k,sum+i,i+1,n,diary,ans);
            diary.remove(diary.size()-1);
         }
    }
    public List<List<Integer>> combinationSum3(int k, int n) {
        List<List<Integer>>ans=new ArrayList<>();
        ArrayList<Integer>diary = new ArrayList<>();
        fun(k,0,1,n,diary,ans);
        return ans;
    }
}
