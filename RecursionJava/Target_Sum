class Solution {


       int ans(int[] arr, int i, int sum, int target, int[][] dp, int offset) {

    if (i == arr.length) {
        return sum == target ? 1 : 0;
    }

    if (dp[i][sum + offset] != -1) {
        return dp[i][sum + offset];
    }

    int plus = ans(arr, i + 1, sum + arr[i], target, dp, offset);
    int minus = ans(arr, i + 1, sum - arr[i], target, dp, offset);

    return dp[i][sum + offset] = plus + minus;
}
    public int findTargetSumWays(int[] nums, int target) {
    int total=0;
    int n=nums.length;
    for(int x:nums){
        total=total+x;
    }
   int[][]dp=new int[n][2*total+1];

for(int[]row:dp){
    Arrays.fill(row,-1);
}
    return ans(nums,0,0,target,dp,total);
    }
}
