class Solution {
void dfs(int[][]image,int i,int j,boolean[][]vis,int n,int m,int old,int color){
    if(i<0 || i>=n||j<0||j>=m|| vis[i][j]||image[i][j]!=old){
        return ;
    }

vis[i][j]=true;
image[i][j]=color;
dfs(image,i-1,j,vis,n,m,old,color);
dfs(image,i+1,j,vis,n,m,old,color);
dfs(image,i,j-1,vis,n,m,old,color);
dfs(image,i,j+1,vis,n,m,old,color);
    // all  theb4 directions
}
    public int[][] floodFill(int[][] image, int sr, int sc, int color) {
        int n=image.length;
        int m=image[0].length;
     int old=image[sr][sc];
     boolean[][]vis=new boolean[n][m];
     dfs(image,sr,sc,vis,n,m,old,color);
     return image ;
    
        }
    }
