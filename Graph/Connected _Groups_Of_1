class Solution {
    void dfs(int[][]grid,int i,int j,int n,int m,boolean[][]vis){
        if(i<0 || i>=n || j<0|| j>=m||grid[i][j]==0 || vis[i][j]){
            return  ;
        }
        
        
        vis[i][j]=true;
        
        dfs(grid,i-1,j,n,m,vis);
        dfs(grid,i+1,j,n,m,vis);
        
        dfs(grid,i,j-1,n,m,vis);
        dfs(grid,i,j+1,n,m,vis);
    }
       
       
    
    
    public int countGroups(int[][] grid) {
        // code here
        int count=0;
        
        int n=grid.length;
        int m=grid[0].length;
        boolean[][]vis=new boolean[n][m];
        
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(grid[i][j]==1){
                    count++;
                    
                    dfs(grid,i,j,n,m,vis);
                }
            }
        }
        
        return count;
    }
}

